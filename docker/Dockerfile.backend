# ── Stage 1: Build ─────────────────────────────────────────────────────────
FROM node:20-alpine AS builder
WORKDIR /app

# Copy workspace manifests first for layer caching
COPY package.json package-lock.json ./
COPY apps/backend-server/package.json ./apps/backend-server/

RUN npm ci --workspace=apps/backend-server

COPY apps/backend-server ./apps/backend-server
COPY tsconfig.json ./

RUN npm run build --workspace=apps/backend-server

# ── Stage 2: Production ────────────────────────────────────────────────────
FROM node:20-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production

COPY --from=builder /app/apps/backend-server/dist ./dist
COPY --from=builder /app/apps/backend-server/package.json ./
COPY --from=builder /app/node_modules ./node_modules

EXPOSE 4000

HEALTHCHECK --interval=30s --timeout=10s --start-period=15s --retries=3 \
  CMD wget -qO- http://localhost:4000/health || exit 1

CMD ["node", "dist/index.js"]
