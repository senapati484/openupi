# Server Config
PORT=4000
NODE_ENV=production

# Storage
MONGO_URI=mongodb://localhost:27017/openupi
REDIS_URI=redis://localhost:6379

# Merchant Identity
MERCHANT_VPA=yourname@okaxis
MERCHANT_NAME=MyAwesomeBusiness

# Security Secrets (generate with: openssl rand -hex 32)
DEVICE_SHARED_SECRET=replace_with_openssl_rand_hex_32
MERCHANT_API_KEY=sk_live_replace_with_openssl_rand_hex_16

# Telegram Ops Alerts (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Cloudflare Tunnel (optional, for home/office servers without static IP)
CLOUDFLARE_TUNNEL_TOKEN=
