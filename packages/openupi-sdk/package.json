{
  "name": "openupi-sdk",
  "version": "1.0.0",
  "description": "Zero-fee self-hosted UPI payment gateway SDK and React checkout widgets",
  "keywords": [
    "upi",
    "payment",
    "india",
    "fintech",
    "qr-code",
    "react",
    "nextjs",
    "express",
    "fastify",
    "webhook",
    "self-hosted",
    "zero-fee",
    "openupi"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/senapati484/openupi.git"
  },
  "bugs": {
    "url": "https://github.com/senapati484/openupi/issues"
  },
  "homepage": "https://github.com/senapati484/openupi/tree/main/packages/openupi-sdk#readme",
  "license": "MIT",
  "author": "Sayan Senapati",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "import": "./dist/node/index.js",
      "require": "./dist/node/index.cjs"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js",
      "require": "./dist/react/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {},
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsup": "^8.0.2",
    "typescript": "^5.4.0",
    "vitest": "^1.4.0"
  }
}
